# OpsMate MCP Server Environment Configuration
# Copy this file to mcp/.env and fill in actual values.
# Never commit real .env files — they are listed in .gitignore.

# ============================================================
# POSTGRESQL — REQUIRED
# ============================================================
# Database connection string for the MCP server's PostgreSQL instance.
# Must point to the same database as the backend (opsmate database).
# Format: postgresql://user:password@host:port/database
# Example: postgresql://opsmate:opsmate_password@localhost:5432/opsmate
DATABASE_URL=postgresql://opsmate:opsmate_password@localhost:5432/opsmate

# ============================================================
# AUTHENTICATION (OPTIONAL — STDIO CLIENTS)
# ============================================================
# Session token for stdio-based MCP clients (e.g., Claude Desktop).
# When set, clients can authenticate via the login tool rather than
# presenting a Bearer token on every HTTP request.
# 
# To generate a token: run the create-admin script or register/login
# through the MCP auth flow, then paste the token here.
#
# If left empty, HTTP clients must send Authorization: Bearer <token>
# on each request; stdio clients have no in-process session memory.
MCP_AUTH_TOKEN=

# ============================================================
# AUTH SECURITY SETTINGS
# ============================================================
# bcrypt cost factor for password hashing
# Higher = more secure but slower; 12 is a good default
BCRYPT_COST=12

# Session expiry in milliseconds (optional)
# If set, sessions will expire after this many ms
# Example: 30 * 24 * 3600 * 1000 = 30 days
# MCP_AUTH_TOKEN expires are handled separately via create-admin.js --ttl-days

# ============================================================
# MISCELLANEOUS
# ============================================================
# Debug mode — enable additional logging
# DEBUG=mcp:* 

# Server port
PORT=8080